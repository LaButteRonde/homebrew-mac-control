{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LaButteRonde/homebrew-mac-control/blob/main/docs/contrat/1.3.schema.json",
  "title": "Contrat des plugins Mac Control 1.3",
  "description": "Messages JSON-RPC 2.0 (une ligne par message) et éléments d'interface. Voir 1.3.md.",
  "$defs": {
    "node": {
      "description": "Un élément d'interface, choisi par type. Un type inconnu est affiché « non pris en charge ».",
      "oneOf": [
        {
          "title": "stack",
          "description": "Empile ses enfants. (depuis 1.0)",
          "type": "object",
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "const": "stack"
            },
            "id": {
              "type": "string"
            },
            "axis": {
              "enum": [
                "vertical",
                "horizontal"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "title": "section",
          "description": "Un bloc titré. (depuis 1.0)",
          "type": "object",
          "required": [
            "type",
            "title"
          ],
          "properties": {
            "type": {
              "const": "section"
            },
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "footer": {
              "type": "string"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "title": "text",
          "description": "Du texte. (depuis 1.0)",
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "style": {
              "enum": [
                "body",
                "secondary",
                "title",
                "monospace"
              ]
            }
          }
        },
        {
          "title": "status",
          "description": "Un symbole teinté et un texte. (depuis 1.0)",
          "type": "object",
          "required": [
            "type",
            "symbol",
            "text"
          ],
          "properties": {
            "type": {
              "const": "status"
            },
            "id": {
              "type": "string"
            },
            "symbol": {
              "type": "string"
            },
            "tint": {
              "enum": [
                "accent",
                "warning",
                "critical",
                "neutral",
                "lamp"
              ]
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "title": "toggle",
          "description": "Interrupteur ; envoie toggle (bool). (depuis 1.0)",
          "type": "object",
          "required": [
            "type",
            "id",
            "label",
            "value"
          ],
          "properties": {
            "type": {
              "const": "toggle"
            },
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "value": {
              "type": "boolean"
            },
            "disabled": {
              "type": "boolean"
            },
            "help": {
              "type": "string"
            }
          }
        },
        {
          "title": "button",
          "description": "Bouton ; envoie press. (depuis 1.0)",
          "type": "object",
          "required": [
            "type",
            "id",
            "label"
          ],
          "properties": {
            "type": {
              "const": "button"
            },
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "symbol": {
              "type": "string"
            },
            "role": {
              "enum": [
                "normal",
                "primary",
                "destructive"
              ]
            },
            "disabled": {
              "type": "boolean"
            }
          }
        },
        {
          "title": "picker",
          "description": "Choix ; envoie select (id de l'option). (depuis 1.0)",
          "type": "object",
          "required": [
            "type",
            "id",
            "label",
            "options",
            "value"
          ],
          "properties": {
            "type": {
              "const": "picker"
            },
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "label"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "title": "time",
          "description": "Heure ; envoie change (HH:MM). (depuis 1.0)",
          "type": "object",
          "required": [
            "type",
            "id",
            "label",
            "value"
          ],
          "properties": {
            "type": {
              "const": "time"
            },
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9]{2}:[0-9]{2}$"
            }
          }
        },
        {
          "title": "textField",
          "description": "Champ texte ; envoie change (texte). (depuis 1.0)",
          "type": "object",
          "required": [
            "type",
            "id",
            "label",
            "value"
          ],
          "properties": {
            "type": {
              "const": "textField"
            },
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "placeholder": {
              "type": "string"
            }
          }
        },
        {
          "title": "prompt",
          "description": "Petite fenêtre de saisie ; envoie change (texte) ou press {action: cancel}. (depuis 1.0)",
          "type": "object",
          "required": [
            "type",
            "id",
            "title",
            "field",
            "confirm",
            "cancel"
          ],
          "properties": {
            "type": {
              "const": "prompt"
            },
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "field": {
              "type": "object",
              "required": [
                "label",
                "value"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "placeholder": {
                  "type": "string"
                }
              }
            },
            "confirm": {
              "type": "string"
            },
            "cancel": {
              "type": "string"
            }
          }
        },
        {
          "title": "countdown",
          "description": "Compte à rebours. (depuis 1.0)",
          "type": "object",
          "required": [
            "type",
            "until"
          ],
          "properties": {
            "type": {
              "const": "countdown"
            },
            "id": {
              "type": "string"
            },
            "until": {
              "type": "string",
              "format": "date-time"
            },
            "prefix": {
              "type": "string"
            }
          }
        },
        {
          "title": "list",
          "description": "Liste ; une action de ligne envoie press {row, action}. (depuis 1.0)",
          "type": "object",
          "required": [
            "type",
            "id",
            "rows",
            "empty"
          ],
          "properties": {
            "type": {
              "const": "list"
            },
            "id": {
              "type": "string"
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/listRow"
              }
            },
            "empty": {
              "type": "string"
            }
          }
        },
        {
          "title": "progress",
          "description": "Barre de progression. (depuis 1.0)",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "progress"
            },
            "id": {
              "type": "string"
            },
            "value": {
              "type": "number"
            },
            "total": {
              "type": "number"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "title": "divider",
          "description": "Trait de séparation. (depuis 1.0)",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "divider"
            },
            "id": {
              "type": "string"
            }
          }
        },
        {
          "title": "disclosure",
          "description": "Accordéon ; envoie toggle (bool) depuis 1.2. (depuis 1.1)",
          "type": "object",
          "required": [
            "type",
            "id",
            "title"
          ],
          "properties": {
            "type": {
              "const": "disclosure"
            },
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "expanded": {
              "type": "boolean",
              "description": "État de départ ; le choix de l'utilisateur l'emporte ensuite."
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "title": "tabs",
          "description": "Sous-onglets ; envoie select (id de la page) depuis 1.2. (depuis 1.1)",
          "type": "object",
          "required": [
            "type",
            "id",
            "tabs"
          ],
          "properties": {
            "type": {
              "const": "tabs"
            },
            "id": {
              "type": "string"
            },
            "selected": {
              "type": "string",
              "description": "Page de départ ; le choix de l'utilisateur l'emporte ensuite."
            },
            "tabs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/nodeTab"
              }
            }
          }
        },
        {
          "title": "sheet",
          "description": "Feuille par-dessus l'onglet ; fermée par l'utilisateur, envoie toggle false. (depuis 1.2)",
          "type": "object",
          "required": [
            "type",
            "id",
            "title"
          ],
          "properties": {
            "type": {
              "const": "sheet"
            },
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "presented": {
              "type": "boolean",
              "default": false
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "title": "indicator",
          "description": "Un voyant et son état en grand (depuis 1.3)",
          "type": "object",
          "required": [
            "type",
            "lit",
            "title"
          ],
          "properties": {
            "type": {
              "const": "indicator"
            },
            "id": {
              "type": "string"
            },
            "lit": {
              "type": "boolean"
            },
            "title": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            }
          }
        }
      ]
    },
    "listRow": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "trailing": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "normal",
                  "primary",
                  "destructive"
                ]
              }
            }
          }
        },
        "detail": {
          "type": "string",
          "description": "Commande ou chemin, en police à chasse fixe (depuis 1.3)."
        }
      }
    },
    "nodeTab": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "apiVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "surface": {
      "enum": [
        "tab",
        "menu"
      ]
    },
    "capabilities": {
      "type": "object",
      "required": [
        "nodes",
        "events",
        "features"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "version",
        "apiVersion",
        "author",
        "executable",
        "symbol",
        "surfaces"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "author": {
          "type": "string"
        },
        "executable": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "message.initialize": {
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "id",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "initialize"
        },
        "id": {
          "type": [
            "integer",
            "string"
          ]
        },
        "params": {
          "type": "object",
          "required": [
            "apiVersion",
            "regie",
            "locale",
            "appearance",
            "dataDir"
          ],
          "properties": {
            "apiVersion": {
              "$ref": "#/$defs/apiVersion"
            },
            "regie": {
              "type": "object",
              "required": [
                "version"
              ],
              "properties": {
                "version": {
                  "type": "string"
                }
              }
            },
            "locale": {
              "type": "string"
            },
            "appearance": {
              "enum": [
                "light",
                "dark"
              ]
            },
            "dataDir": {
              "type": "string"
            },
            "capabilities": {
              "$ref": "#/$defs/capabilities"
            }
          }
        }
      }
    },
    "message.initializeResult": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "integer",
            "string"
          ]
        },
        "result": {
          "type": "object",
          "required": [
            "apiVersion",
            "plugin"
          ],
          "properties": {
            "apiVersion": {
              "$ref": "#/$defs/apiVersion"
            },
            "plugin": {
              "type": "object",
              "required": [
                "id",
                "name",
                "version"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "message.initialized": {
      "type": "object",
      "required": [
        "jsonrpc",
        "method"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "initialized"
        }
      }
    },
    "message.uiEvent": {
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "id",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "ui/event"
        },
        "id": {
          "type": [
            "integer",
            "string"
          ]
        },
        "params": {
          "type": "object",
          "required": [
            "surface",
            "node",
            "kind"
          ],
          "properties": {
            "surface": {
              "$ref": "#/$defs/surface"
            },
            "node": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "press",
                "toggle",
                "select",
                "change"
              ]
            },
            "value": {}
          }
        }
      }
    },
    "message.surfaceVisibility": {
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "surface/visibility"
        },
        "params": {
          "type": "object",
          "required": [
            "surface",
            "visible"
          ],
          "properties": {
            "surface": {
              "$ref": "#/$defs/surface"
            },
            "visible": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "message.appearanceChanged": {
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "appearance/changed"
        },
        "params": {
          "type": "object",
          "required": [
            "appearance"
          ],
          "properties": {
            "appearance": {
              "enum": [
                "light",
                "dark"
              ]
            }
          }
        }
      }
    },
    "message.notificationClick": {
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "notification/click"
        },
        "params": {
          "type": "object",
          "required": [],
          "properties": {
            "id": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      }
    },
    "message.shutdown": {
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "id"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "shutdown"
        },
        "id": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "message.surfaceRender": {
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "surface/render"
        },
        "params": {
          "type": "object",
          "required": [
            "surface",
            "root"
          ],
          "properties": {
            "surface": {
              "$ref": "#/$defs/surface"
            },
            "root": {
              "$ref": "#/$defs/node"
            }
          }
        }
      }
    },
    "message.statusSet": {
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "status/set"
        },
        "params": {
          "type": "object",
          "required": [],
          "properties": {
            "symbol": {
              "type": "string"
            },
            "tint": {
              "enum": [
                "accent",
                "warning",
                "critical",
                "neutral",
                "lamp"
              ]
            },
            "label": {
              "type": "string"
            },
            "priority": {
              "enum": [
                "normal",
                "high"
              ]
            }
          }
        }
      }
    },
    "message.notify": {
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "notify"
        },
        "params": {
          "type": "object",
          "required": [
            "title",
            "body"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "description": "http ou https seulement"
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "message.logWrite": {
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "log/write"
        },
        "params": {
          "type": "object",
          "required": [
            "level",
            "message"
          ],
          "properties": {
            "level": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "message.response": {
